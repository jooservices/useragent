{
  "name": "jooservices/useragent",
  "description": "Deterministic, dataset-backed synthetic User-Agent profiles for tests and fixtures.",
  "type": "library",
  "license": "MIT",
  "keywords": ["fixtures", "php", "testing", "user-agent"],
  "support": {
    "issues": "https://github.com/jooservices/useragent/issues",
    "source": "https://github.com/jooservices/useragent"
  },
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "jooservices/dto": "^3.0"
  },
  "require-dev": {
    "captainhook/captainhook": "^5.23",
    "captainhook/plugin-composer": "^5.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "laravel/pint": "^1.18",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.0",
    "squizlabs/php_codesniffer": "^3.12 || ^4.0"
  },
  "autoload": {
    "psr-4": {"JOOservices\\UserAgent\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"JOOservices\\UserAgent\\Tests\\": "tests/"}
  },
  "bin": ["bin/useragent"],
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:coverage": "phpunit --coverage-html coverage --coverage-clover coverage.xml",
    "coverage:check": "php tools/coverage-enforce.php coverage.xml",
    "lint:pint": "pint --test",
    "lint:pint:fix": "pint",
    "lint:phpcs": "phpcs --standard=phpcs.xml",
    "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
    "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
    "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
    "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
    "lint": ["@lint:pint", "@lint:phpcs", "@lint:phpstan", "@lint:phpmd", "@lint:cs"],
    "lint:fix": ["@lint:pint:fix", "@lint:cs:fix"],
    "check": ["@lint", "@test"],
    "ci": ["@lint", "@test:coverage", "@coverage:check"],
    "hooks:install": "captainhook install --force --skip-existing",
    "post-install-cmd": "captainhook install --force --skip-existing",
    "post-update-cmd": "captainhook install --force --skip-existing"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "captainhook/plugin-composer": true
    },
    "audit": {"abandoned": "ignore"}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
